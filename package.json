{
  "name": "activexremote-campus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "tools:icons": "node scripts/build-tool-icons.mjs",
    "tools:logos": "node scripts/fetch-logos.mjs --write",
    "blog:art": "node scripts/build-blog-art.mjs && node scripts/attach-blog-art.mjs",
    "stripe:setup": "node --experimental-strip-types --import ./scripts/alias-loader.mjs scripts/stripe-setup.mjs",
    "check:links": "node scripts/check-links.mjs",
    "lens:audit": "node --experimental-strip-types --import ./scripts/alias-loader.mjs scripts/audit-calculadora.mjs",
    "blog:schedule": "node scripts/blog-schedule.mjs",
    "blog:links": "node scripts/blog-links.mjs",
    "glossary:art": "node --experimental-strip-types scripts/build-glossary-art.mjs",
    "tools:payment": "node scripts/build-payment-icons.mjs",
    "relampago:seed": "node --experimental-strip-types --import ./scripts/alias-loader.mjs scripts/build-relampago-seed.mjs"
  },
  "dependencies": {
    "@carbon/grid": "^11.56.0",
    "@carbon/icons-react": "^11.81.0",
    "@carbon/react": "^1.108.0",
    "@carbon/styles": "^1.107.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "next": "16.2.6",
    "openai": "^7.5.0",
    "pdfkit": "^0.15.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sass": "^1.99.0",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "payment-icons": "^1.2.1",
    "simple-icons": "^16.28.0",
    "typescript": "^5"
  }
}
