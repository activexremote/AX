NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://...
CRON_SECRET=cualquier-cadena-secreta-larga

# ── Stripe ────────────────────────────────────────────────
# Claves del panel (usa las de test hasta que la web sea pública).
STRIPE_SECRET_KEY=sk_test_...
# Secreto del endpoint del webhook (Developers → Webhooks → tu endpoint).
# En local lo imprime `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=whsec_...

# Identificadores de precio. Los crea e imprime `node scripts/stripe-setup.mjs --write`.
STRIPE_PRICE_CURSO_UNICO=price_...
STRIPE_PRICE_CURSO_ANTICIPADA=price_...
STRIPE_PRICE_CURSO_PLAZOS=price_...
STRIPE_PRICE_PACK_DOS=price_...

# Cursos relámpago: un price_ por curso. El nombre se deriva de la clave del
# curso (web-abc → RELAMPAGO_WEB_ABC), lo genera `flashPriceEnv()`.
STRIPE_PRICE_RELAMPAGO_WEB_ABC=price_...

# ── Corrección automática de las misiones ─────────────────
# Opcional. Sin ella el campus sigue funcionando: las entregas se guardan y
# quedan marcadas para revisión manual desde el panel, en vez de corregirse
# solas. Con ella, la corrección sigue la rúbrica del curso.
OPENAI_API_KEY=sk-proj-...
# Modelo. Se puede cambiar sin tocar código; por defecto, gpt-4o.
OPENAI_REVIEW_MODEL=gpt-4o

# URL pública del sitio. La usa el correo de acceso que se manda al matricularse
# para construir el enlace de vuelta. En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://activexremote.com

# ── Verificación del teléfono por SMS ─────────────────────
# Apagada: cada código cuesta dinero en el proveedor. El registro sigue
# pidiendo el teléfono y guardándolo, pero al campus se entra sólo con el
# enlace mágico del correo.
#
# Para encenderla: "on" aquí + un proveedor de SMS en Supabase
# (Authentication → Providers → Phone). Vuelve el paso /verificar-telefono.
NEXT_PUBLIC_PHONE_OTP=off

# ── Zoho CRM ──────────────────────────────────────────────
# Los formularios de la web crean el lead en Zoho, y el webhook de Stripe lo
# convierte en contacto + negocio ganado cuando se paga la matrícula.
#
# Se saca de la consola de Zoho (api-console.zoho.eu → Self Client) y se
# canjea con: npm run zoho:setup -- <código>
ZOHO_CLIENT_ID=1000.XXXXXXXXXXXXXXXXXXXXXXXXXXXX
ZOHO_CLIENT_SECRET=...
ZOHO_REFRESH_TOKEN=1000....
# Sólo si tu cuenta NO es europea: .com, .in, .com.au, .jp
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.eu
# El nombre EXACTO de la etapa de "ganado" en tu cuenta: en una cuenta en
# español es "Cierre ganado", no "Closed Won". Lo dice `npm run zoho:probe`.
ZOHO_DEAL_STAGE=Closed Won
# Origen que se pone a los leads. ⚠︎ Es una LISTA DE VALORES de Zoho, no texto
# libre: si el valor no existe, Zoho rechaza el registro entero y el lead se
# pierde. `npm run zoho:probe` imprime los que hay en tu cuenta. Sin variable,
# el campo no se manda y Zoho aplica el suyo por defecto.
ZOHO_LEAD_SOURCE=OnlineStore
# Y el que se pone a quien llega desde un anuncio (landings /lp/, o URL con
# utm_medium de pago o identificador de clic). Tiene que estar en la misma
# lista. "Advertisement" viene de serie en Zoho.
ZOHO_LEAD_SOURCE_ADS=Advertisement

# ── Narración de las lecciones (Fish Audio) ───────────────
# Opcional. Sin ella el campus funciona igual: el editor de lección sigue
# dejando subir el MP3 a mano, lo único que desaparece es el botón de
# generarlo desde el contenido.
#
# La clave se saca en fish.audio → Settings → API Keys.
# Comprueba que va y lista tus voces con:  npm run fish:setup
FISH_API_KEY=
# Id de la voz. El que viene puesto es "Narrador v2", una voz genérica de
# narración en español neutro. Compara alternativas por oído con:
#   npm run fish:setup -- --comparar
# Y si quieres que el campus suene contigo: fish.audio → Voice Cloning.
FISH_VOICE_ID=35199d5438854f5d9157c500479ab684
# Motor. `s1` es el bueno; `speech-1.6` sale más barato. Por defecto, s1.
FISH_MODEL=s1

# ── Etiquetas de marketing (GTM, Google Ads, píxel de Meta) ──
# Los IDs ya están en src/lib/analytics/config.ts; estas variables sólo los
# pisan. Se cargan únicamente en producción (VERCEL_ENV=production) y en las
# páginas públicas: nunca en el campus ni en el panel. TRACKING_FORCE=1 las
# enciende en local para probar con Tag Assistant / Meta Pixel Helper.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=
TRACKING_FORCE=

# ── Voz de las lecciones: proveedor ──────────────────────
# "openai" (pago por uso con OPENAI_API_KEY) o "fish" (FISH_API_KEY; Fish
# sólo vende crédito de API dentro del plan Pro). Vacío: Fish si hay su
# clave, si no OpenAI.
TTS_PROVIDER=openai
# Voz de OpenAI: alloy, ash, ballad, coral, echo, fable, nova, onyx, sage,
# shimmer, verse. La inglesa es opcional; sin ella, la misma.
TTS_OPENAI_VOICE=coral
TTS_OPENAI_VOICE_EN=
# gpt-4o-mini-tts entiende indicaciones de acento; tts-1 es la alternativa.
TTS_OPENAI_MODEL=gpt-4o-mini-tts
